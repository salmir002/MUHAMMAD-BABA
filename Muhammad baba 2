* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f6fb;
    color: #17233b;
}

header {
    background: #101c3a;
    color: white;
    padding: 22px 6%;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 19px;
    font-weight: bold;
    color: #f5c542;
}

.hero {
    background: linear-gradient(135deg, #101c3a, #174c91);
    color: white;
    padding: 65px 7%;
    text-align: center;
}

.hero h1 {
    font-size: 32px;
    margin-bottom: 15px;
}

.hero p {
    font-size: 16px;
    margin-bottom: 25px;
    line-height: 1.6;
}

.hero button {
    background: #f5c542;
    color: #101c3a;
    border: none;
    padding: 14px 30px;
    border-radius: 8px;
    font-weight: bold;
}

.container {
    padding: 35px 6%;
}

.container h2 {
    margin-bottom: 20px;
}

.services {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
}

.service {
    background: white;
    padding: 25px 15px;
    border-radius: 12px;
    text-align: center;
    box-shadow: 0 3px 12px rgba(0,0,0,0.05);
}

.service h3 {
    margin-bottom: 10px;
    color: #174c91;
}

.service p {
    font-size: 13px;
    color: #777;
}

footer {
    background: #101c3a;
    color: white;
    padding: 25px;
    text-align: center;
    margin-top: 40px;
}

@media(max-width: 480px) {
    .hero h1 {
        font-size: 25px;
    }

    .services {
        grid-template-columns: repeat(2, 1fr);
    }
}
